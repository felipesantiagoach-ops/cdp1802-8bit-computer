   000d                 R13		EQU	13
   000e                 R14		EQU	14
   000f                 R15		EQU	15
                        
   0000                 r0		EQU	0
   0001                 r1		EQU	1
   0002                 r2		EQU	2
   0003                 r3		EQU	3
   0004                 r4		EQU	4
